#!/usr/bin/env bash
# npm stub for the publish-tarballs bats suite.
#
# `npm view <name>@<version> ...`: prints the version when name@version is in
#   NPM_STUB_PUBLISHED (space-separated), otherwise fails with E404.
# `npm publish <tarball> ...`: appends the arguments to NPM_STUB_LOG and the
#   userconfig in effect to NPM_STUB_LOG.npmrc, then fails if the tarball's
#   basename is in NPM_STUB_PUBLISH_FAILING.
case "${1:-}" in
    view)
        spec="$2"
        case " ${NPM_STUB_PUBLISHED:-} " in *" ${spec} "*) echo "${spec##*@}"; exit 0 ;; esac
        echo "npm error code E404" >&2
        exit 1
        ;;
    publish)
        shift
        echo "publish $*" >> "${NPM_STUB_LOG:?}"
        { echo "# $(basename "$1")"; cat "${NPM_CONFIG_USERCONFIG:?}"; } >> "${NPM_STUB_LOG}.npmrc"
        case " ${NPM_STUB_PUBLISH_FAILING:-} " in *" $(basename "$1") "*) echo "npm error code E403" >&2; exit 1 ;; esac
        echo "+ $(basename "$1")"
        ;;
    *)
        echo "npm stub: unexpected command: $*" >&2
        exit 99
        ;;
esac
